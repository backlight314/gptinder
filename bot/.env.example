# Discord bot token (Developer Portal > Bot). Never commit or paste this anywhere.
DISCORD_BOT_TOKEN=

# Where the bot POSTs exported messages (the FastAPI backend).
BACKEND_URL=http://localhost:8000

# Must match INGEST_TOKEN in backend/.env (if set there).
INGEST_TOKEN=

# How many recent channel messages to scan per export.
HISTORY_LIMIT=500
