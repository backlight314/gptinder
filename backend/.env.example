ANTHROPIC_API_KEY=your-key-here

# Small, narrow JSON extractions (communication/preferences/emotions/decisions) -
# cheap model is fine here, they're bulk-style classification calls.
EXTRACTION_MODEL=claude-haiku-4-5

# The in-character date conversation - this is the actual product experience,
# keep it on the strongest model.
DATE_MODEL=claude-opus-5

# Model for the private "reaction" call each turn. Optional - unset (or empty) uses
# DATE_MODEL, so nothing changes unless you set it. A smaller model, e.g. claude-haiku-4-5,
# is cheaper and faster.
# REACTION_MODEL=

# Compatibility scoring - an LLM-judge-style call, mid-tier model is enough.
SCORE_MODEL=claude-sonnet-5

# Shared secret the Discord bot sends as X-Ingest-Token when POSTing to
# /ingest/discord. If set, requests without it are rejected. Use the same value
# in bot/.env. Replace changeme with a long random value; leave empty only for purely local dev.
INGEST_TOKEN=changeme

# Where ingested raw data is stored (default: <repo root>/data). Gitignored.
# DATA_DIR=

# Extracted personas are upserted into MongoDB (collection `extracted_personas`) so they
# sit next to the Next.js app's data. Same values as the root .env. If MONGODB_URI is unset,
# personas are only written to data/processed/.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=gptinder
