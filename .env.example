# Copy to .env.local and set these values locally. Never commit real keys.
OPENAI_API_KEY=

# Optional approved persona material for each agent. MongoDB social posts are
# also used server-side as a compact voice reference during the simulation.
OPENAI_VECTOR_STORE_ID_A=
OPENAI_VECTOR_STORE_ID_B=

# Optional model overrides. Both agents always use OPENAI_API_KEY.
OPENAI_MODEL_A=gpt-5.6-luna
OPENAI_MODEL_B=gpt-5.6-luna

# MongoDB Atlas connection string. Keep this server-only in Vercel.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Legacy default retained for existing deployments; use airos for a fresh database.
MONGODB_DB=gptinder

# Server-only Apify token. LinkedIn, Instagram, and X imports use it.
APIFY_TOKEN=

# Number of posts to store per import (1-30).
PROFILE_IMPORT_MAX_POSTS=12

# Salt anonymous rate-limit identifiers. Generate a long random value in production.
AIROS_RATE_LIMIT_SALT=
AIROS_PREVIEW_LIMIT_PER_HOUR=30
AIROS_IMPORT_LIMIT_PER_HOUR=10
AIROS_ANALYZE_LIMIT_PER_HOUR=5
AIROS_ANALYSIS_MODEL=gpt-5.6-luna
