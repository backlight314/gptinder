# Copy to .env.local. Never commit real credentials.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gptinder_development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AUTH_SECRET=
APP_URL=http://localhost:3000

# Verified email sign-in and recovery (send-only; no mailbox access).
RESEND_API_KEY=
EMAIL_FROM=GPTinder <signin@your-verified-domain.example>

# Leave false for participant deployments. Seeded demo key login still works.
ALLOW_DEMO_AUTH=false

# Optional: protects POST /api/internal/recover for an external scheduler.
CRON_SECRET=

# Retained for the legacy /api/match/conversation route from main.
OPENAI_VECTOR_STORE_ID_A=
OPENAI_VECTOR_STORE_ID_B=
OPENAI_MODEL_A=gpt-5
OPENAI_MODEL_B=gpt-5
