# Copy to .env.local. Never commit real credentials.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gptinder_development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AUTH_SECRET=
APP_URL=http://localhost:3000

# Public profile extraction (server only).
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
PROFILE_IMPORT_MAX_POSTS=12

# Verified email sign-in and recovery (send-only; no mailbox access).
RESEND_API_KEY=
EMAIL_FROM=GPTinder <signin@your-verified-domain.example>
ALLOW_DEMO_AUTH=false
CRON_SECRET=

# Retained for the legacy /api/match/conversation route from main.
OPENAI_VECTOR_STORE_ID_A=
OPENAI_VECTOR_STORE_ID_B=
OPENAI_MODEL_A=gpt-5
OPENAI_MODEL_B=gpt-5
