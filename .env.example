# Copy to .env.local and set these values locally. Never commit real keys.
OPENAI_API_KEY=

# Each vector store contains the approved persona material for one agent.
OPENAI_VECTOR_STORE_ID_A=
OPENAI_VECTOR_STORE_ID_B=

# Optional model overrides. Both agents always use OPENAI_API_KEY.
OPENAI_MODEL_A=gpt-5
OPENAI_MODEL_B=gpt-5

# MongoDB Atlas connection string. Keep this server-only in Vercel.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gptinder

# Server-only Apify token. LinkedIn, Instagram, and X imports use it.
APIFY_TOKEN=

# Optional Browserbase fallback when APIFY_TOKEN is not configured.
BROWSERBASE_API_KEY=
# Optional for older or unscoped Browserbase API keys.
BROWSERBASE_PROJECT_ID=
# Persistent Browserbase Context IDs containing user-approved login state.
BROWSERBASE_LINKEDIN_CONTEXT_ID=
BROWSERBASE_INSTAGRAM_CONTEXT_ID=
BROWSERBASE_X_CONTEXT_ID=

# Number of LinkedIn or browser-discovered posts to store per import (1-50).
PROFILE_IMPORT_MAX_POSTS=12
