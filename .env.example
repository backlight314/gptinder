# Copy to .env.local and set this value locally. Never commit real keys.
OPENAI_API_KEY=

# Each vector store contains the approved persona material for one agent.
OPENAI_VECTOR_STORE_ID_A=
OPENAI_VECTOR_STORE_ID_B=

# Optional model overrides. Both agents always use OPENAI_API_KEY.
OPENAI_MODEL_A=gpt-5
OPENAI_MODEL_B=gpt-5
