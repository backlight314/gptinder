{
  "name": "gptinder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@workflow/core": {
      "nanoid": "^5.1.16"
    },
    "@workflow/world-local": {
      "undici": "^7.29.0"
    },
    "@workflow/world-vercel": {
      "undici": "^7.29.0"
    }
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:http": "tsx --conditions=react-server scripts/http-smoke.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:indexes": "tsx --conditions=react-server scripts/database.ts indexes",
    "db:check": "tsx --conditions=react-server scripts/database.ts check",
    "ai:check": "tsx --conditions=react-server scripts/ai-check.ts",
    "demo:seed": "tsx --conditions=react-server scripts/database.ts seed",
    "format": "prettier --write app components lib workflows scripts tests docs *.json *.mjs *.ts",
    "format:check": "prettier --check app components lib workflows scripts tests docs *.json *.mjs *.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@browserbasehq/sdk": "^2.20.0",
    "@next/env": "^16.3.3",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "mongodb": "^7.6.0",
    "next": "16.3.3",
    "openai": "^7.18.0",
    "playwright-core": "^1.63.0",
    "react": "^19",
    "react-dom": "^19",
    "react-nice-avatar": "^1.5.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "workflow": "^4.8.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/w3c-web-serial": "^1.0.8",
    "fengari": "^0.1.5",
    "mongodb-memory-server": "^11.2.0",
    "postcss": "^8.5",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.7.3",
    "vitest": "^5.0.1"
  }
}
